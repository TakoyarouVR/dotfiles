[user]
	name = TakoyarouVR
	email = kou1105dane@gmail.com
[core]
	excludesfile = /Users/takoyarou/.config/git/ignore
	pager = delta
[init]
	defaultBranch = main
[url "ssh://git@github.com/"]
	insteadOf = https://github.com/
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	dark = true
	line-numbers = true
[merge]
	conflictStyle = zdiff3
